includes:
    - phpstan-baseline.neon
    # Dogfood the rule this package ships to its consumers. extension-installer
    # wires it up for apps; the root package has to include it by hand.
    - extension.neon

parameters:
    level: 6
    ignoreErrors:
        # Laravel 13.42 types Arrayable::toArray() as array<TKey, TValue>, and
        # its paginators implement Arrayable<TKey, TValue> while returning the
        # keyed page (`data`, `path`, …), as ours do. The page is honestly
        # array<string, mixed>; the interface's item typing does not describe it.
        -
            identifier: method.childReturnType
            path: src/Concerns/CarriesFeedKeys.php
            count: 2
    paths:
        - src
        - config
        - database
        - workbench
        # The two testing traits are only ever `use`d by consumers, so PHPStan
        # would otherwise skip them as unused. These two classes use them.
        - tests/Testing/RecordsStoriesTest.php
        - tests/Testing/WithoutRecordingTest.php
    tmpDir: build/phpstan
    # Where THIS package's config lives. Larastan's env()-outside-config rule
    # defaults to the host app's config_path(), which is the testbench
    # skeleton's — so the one env() in config/storyfeed.php read as a leak.
    configDirectories:
        - config
